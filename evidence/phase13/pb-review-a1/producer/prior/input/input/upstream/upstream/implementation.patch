+            r = a['reference']; self.files[c.refkey(r)] = (c.ROOT / r['path']).read_bytes()
+        for p in (FIXTURE / 'events').glob('*.json'):
+            self.files['example/repo', 'a'*40, 'examples/knowledge-collector/events/' + p.name] = p.read_bytes()
+        self.reads = []
