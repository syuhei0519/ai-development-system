@@ -0,0 +1,31 @@
+{{/* Order registration preparation. A synthetic fixture SHA is never a live revision. */}}
+{{- if .Values.orderEnabled }}
+{{- $revision := required "orderTargetRevision is required when orderEnabled=true" .Values.orderTargetRevision }}
+{{- if not (regexMatch "^[0-9a-f]{40}$" $revision) }}
+{{- fail "orderTargetRevision must be a full lowercase Manifest commit SHA" }}
+{{- end }}
+{{- range $index, $app := list (dict "name" "order-postgresql" "wave" "-10") (dict "name" "order" "wave" "0") }}
+{{- if $index }}
+---
+{{- end }}
+apiVersion: argoproj.io/v1alpha1
+kind: Application
+metadata:
+  name: lab-local-{{ $app.name }}
+  namespace: argocd
+  annotations: {argocd.argoproj.io/sync-wave: {{ $app.wave | quote }}, argocd.argoproj.io/sync-options: Prune=confirm}
+spec:
+  project: lab-account
+  source:
+    repoURL: {{ $.Values.applicationRepository }}
+    targetRevision: {{ $revision | quote }}
+    path: charts/{{ $app.name }}
+    helm:
+      releaseName: {{ $app.name }}
+      valueFiles: [../../environments/local/{{ $app.name }}.yaml]
+  destination: {server: https://kubernetes.default.svc, namespace: account}
+  syncPolicy:
+    automated: {prune: true, selfHeal: true, allowEmpty: false}
+    syncOptions: [PruneLast=true, FailOnSharedResource=true]
+{{- end }}
+{{- end }}
