{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-development-system/issue-completion-context.schema.json",
  "title": "issue-completion-context v1.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "document_type": {
      "const": "issue_completion_context"
    },
    "context_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/criterion"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "source",
        "title",
        "acceptance_criteria"
      ]
    },
    "issue_integration_scope": {
      "enum": [
        "aggregate_required",
        "unknown"
      ]
    },
    "scope_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scope_decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scope_decision"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "required_prs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/required_pr"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "required_deployments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/required_deployment"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "required_verifications": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/verification"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "current_members": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/current_member"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "current_deployments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/current_deployment"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "valid_until": {
      "type": "string",
      "format": "date-time"
    },
    "source_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/blob"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "previous_assessment_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "document_type",
    "context_id",
    "issue",
    "issue_integration_scope",
    "scope_revision",
    "scope_decisions",
    "required_prs",
    "required_deployments",
    "required_verifications",
    "current_members",
    "current_deployments",
    "observed_at",
    "valid_until",
    "source_refs",
    "previous_assessment_sha256"
  ],
  "$defs": {
    "blob": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        }
      },
      "required": [
        "id",
        "locator",
        "sha256",
        "size"
      ]
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "verbatim": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "verification_phase": {
          "enum": [
            "premerge",
            "postmerge",
            "postdeploy"
          ]
        }
      },
      "required": [
        "id",
        "verbatim",
        "source",
        "verification_phase"
      ]
    },
    "current_deployment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "deployment_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "state": {
          "enum": [
            "unknown",
            "pending",
            "deployed",
            "failed",
            "rolled_back"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "config_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "images": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/image"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "environment_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "workload_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "deployed_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "deploy_actor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "valid_until": {
          "type": "string",
          "format": "date-time"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/blob"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "deployment_id",
        "state",
        "sources",
        "config_sha256",
        "images",
        "environment_id",
        "workload_id",
        "deployed_at",
        "deploy_actor",
        "observed_at",
        "valid_until",
        "evidence_refs"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "deployed",
                  "rolled_back"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "config_sha256": {
                "not": {
                  "type": "null"
                }
              },
              "deployed_at": {
                "not": {
                  "type": "null"
                }
              },
              "deploy_actor": {
                "not": {
                  "type": "null"
                }
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/blob"
                },
                "minItems": 1,
                "uniqueItems": true
              }
            }
          }
        }
      ]
    },
    "current_member": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "member_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "state": {
          "enum": [
            "unknown",
            "open",
            "merged",
            "closed_unmerged",
            "reverted"
          ]
        },
        "head_sha": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "base_sha": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "target_revision": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "config_revision": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "merge_group_sha": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "merge_sha": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "merged_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "merge_actor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "valid_until": {
          "type": "string",
          "format": "date-time"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/blob"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "member_id",
        "state",
        "head_sha",
        "base_sha",
        "target_revision",
        "config_revision",
        "merge_group_sha",
        "merge_sha",
        "merged_at",
        "merge_actor",
        "observed_at",
        "valid_until",
        "evidence_refs"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "merged",
                  "reverted"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "head_sha": {
                "not": {
                  "type": "null"
                }
              },
              "base_sha": {
                "not": {
                  "type": "null"
                }
              },
              "target_revision": {
                "not": {
                  "type": "null"
                }
              },
              "config_revision": {
                "not": {
                  "type": "null"
                }
              },
              "merge_sha": {
                "not": {
                  "type": "null"
                }
              },
              "merged_at": {
                "not": {
                  "type": "null"
                }
              },
              "merge_actor": {
                "not": {
                  "type": "null"
                }
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/blob"
                },
                "minItems": 1,
                "uniqueItems": true
              }
            }
          }
        }
      ]
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "component": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "component",
        "digest"
      ]
    },
    "required_deployment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "deployment_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "definition_state": {
          "enum": [
            "unknown",
            "defined"
          ]
        },
        "environment_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "workload_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "member_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "expected_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "expected_config_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "image_requirement": {
          "enum": [
            "required",
            "none",
            "unknown"
          ]
        },
        "expected_images": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/image"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "no_image_basis": {
          "anyOf": [
            {
              "$ref": "#/$defs/blob"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "deployment_id",
        "definition_state",
        "environment_id",
        "workload_id",
        "member_ids",
        "expected_sources",
        "expected_config_sha256",
        "image_requirement",
        "expected_images",
        "no_image_basis"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "definition_state": {
                "const": "defined"
              }
            }
          },
          "then": {
            "properties": {
              "expected_sources": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/source"
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "expected_config_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "image_requirement": {
                "enum": [
                  "required",
                  "none"
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "image_requirement": {
                      "const": "required"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "expected_images": {
                      "type": "array",
                      "items": {
                        "$ref": "#/$defs/image"
                      },
                      "minItems": 1,
                      "uniqueItems": true
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "image_requirement": {
                      "const": "none"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "expected_images": {
                      "maxItems": 0
                    },
                    "no_image_basis": {
                      "$ref": "#/$defs/blob"
                    }
                  }
                }
              }
            ]
          }
        }
      ]
    },
    "required_pr": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "member_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "repository": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "pr_number": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "ac_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "requirement_source": {
          "$ref": "#/$defs/blob"
        }
      },
      "required": [
        "member_id",
        "repository",
        "pr_number",
        "scope",
        "ac_ids",
        "depends_on",
        "requirement_source"
      ]
    },
    "scope_decision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "status": {
          "enum": [
            "approved",
            "pending",
            "revoked"
          ]
        },
        "authority": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "actor": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "decision_kind": {
          "enum": [
            "required_scope",
            "product_operation",
            "delivery"
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "issue_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "member_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "deployment_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "allowed_actions": {
          "type": "array",
          "items": {
            "enum": [
              "assess",
              "implement",
              "merge",
              "deploy",
              "rollback",
              "close_issue",
              "publish",
              "consume"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/blob"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "valid_until": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "scope_id",
        "revision",
        "status",
        "authority",
        "actor",
        "decision_kind",
        "scope",
        "issue_id",
        "member_ids",
        "deployment_ids",
        "allowed_actions",
        "evidence_refs",
        "observed_at",
        "valid_until"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "required": [
        "repository",
        "revision"
      ]
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "verification_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "ac_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "phase": {
          "enum": [
            "premerge",
            "postmerge",
            "postdeploy"
          ]
        },
        "member_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "deployment_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "environment_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "workload_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "expected_result": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "failure_action": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "verification_id",
        "ac_id",
        "phase",
        "member_ids",
        "deployment_ids",
        "environment_id",
        "workload_id",
        "method",
        "expected_result",
        "owner",
        "failure_action"
      ]
    }
  }
}
