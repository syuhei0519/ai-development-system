{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-development-system/readiness-context.schema.json",
  "title": "readiness-context v1.0 / v1.1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "document_type": {
      "const": "readiness_context"
    },
    "schema_version": {
      "enum": [
        "1.0",
        "1.1"
      ]
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "issue_id": {
      "$ref": "#/$defs/text"
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/criterion"
      },
      "minItems": 1
    },
    "pr_ac_ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      },
      "uniqueItems": true
    },
    "deployment_effect": {
      "enum": [
        "none",
        "automatic",
        "unknown"
      ]
    },
    "policy_observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "policy_valid_until": {
      "type": "string",
      "format": "date-time"
    },
    "policy_evidence": {
      "$ref": "#/$defs/text"
    },
    "github_requirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "checks": {
          "type": "boolean"
        },
        "reviews": {
          "type": "boolean"
        },
        "queue": {
          "type": "boolean"
        }
      },
      "required": [
        "checks",
        "reviews",
        "queue"
      ]
    },
    "issue_integration_scope": {
      "enum": [
        "single_pr",
        "aggregate_required",
        "unknown"
      ]
    },
    "pr_kind": {
      "enum": [
        "standard",
        "preparation"
      ]
    },
    "preparation": {
      "anyOf": [
        {
          "$ref": "#/$defs/preparation"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "document_type",
    "schema_version",
    "subject",
    "issue_id",
    "acceptance_criteria",
    "pr_ac_ids",
    "deployment_effect",
    "policy_observed_at",
    "policy_valid_until",
    "policy_evidence",
    "github_requirements",
    "issue_integration_scope"
  ],
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "$ref": "#/$defs/text"
        },
        "pr_number": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "head_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "base_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "target_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "config_revision": {
          "$ref": "#/$defs/text"
        },
        "merge_group_sha": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "repository",
        "pr_number",
        "head_sha",
        "base_sha",
        "target_revision",
        "config_revision",
        "merge_group_sha"
      ]
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/text"
        },
        "verbatim": {
          "$ref": "#/$defs/text"
        },
        "source": {
          "$ref": "#/$defs/text"
        },
        "verification_phase": {
          "enum": [
            "premerge",
            "postmerge",
            "postdeploy"
          ]
        }
      },
      "required": [
        "id",
        "verbatim",
        "source",
        "verification_phase"
      ]
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "verdict": {
          "enum": [
            "pass",
            "fail",
            "pending",
            "not_applicable"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "reason": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "verdict",
        "evidence_ids",
        "reason"
      ]
    },
    "preparation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope_reason": {
          "$ref": "#/$defs/text"
        },
        "related_ac_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/text"
              },
              "verbatim": {
                "$ref": "#/$defs/text"
              },
              "method": {
                "$ref": "#/$defs/text"
              },
              "expected_result": {
                "$ref": "#/$defs/text"
              }
            },
            "required": [
              "id",
              "verbatim",
              "method",
              "expected_result"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/text"
              },
              "locator": {
                "$ref": "#/$defs/text"
              },
              "revision": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "size_bytes": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "id",
              "locator",
              "revision",
              "sha256",
              "size_bytes"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "followup": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "ac_id": {
                "$ref": "#/$defs/text"
              },
              "owner": {
                "$ref": "#/$defs/text"
              },
              "environment": {
                "$ref": "#/$defs/text"
              },
              "method": {
                "$ref": "#/$defs/text"
              },
              "dependencies": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/text"
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "failure_action": {
                "$ref": "#/$defs/text"
              }
            },
            "required": [
              "ac_id",
              "owner",
              "environment",
              "method",
              "dependencies",
              "failure_action"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "product_outcomes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "ac_id": {
                "$ref": "#/$defs/text"
              },
              "outcome": {
                "enum": [
                  "met",
                  "not_met",
                  "unverified"
                ]
              }
            },
            "required": [
              "ac_id",
              "outcome"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "scope_reason",
        "related_ac_ids",
        "conditions",
        "artifacts",
        "followup",
        "product_outcomes"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.0"
          }
        }
      },
      "then": {
        "properties": {
          "pr_ac_ids": {
            "minItems": 1
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "pr_kind"
              ]
            },
            {
              "required": [
                "preparation"
              ]
            }
          ]
        }
      },
      "else": {
        "required": [
          "pr_kind",
          "preparation"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "pr_kind": {
            "const": "preparation"
          }
        },
        "required": [
          "pr_kind"
        ]
      },
      "then": {
        "properties": {
          "schema_version": {
            "const": "1.1"
          },
          "preparation": {
            "$ref": "#/$defs/preparation"
          },
          "pr_ac_ids": {
            "maxItems": 0
          },
          "deployment_effect": {
            "const": "none"
          },
          "issue_integration_scope": {
            "const": "aggregate_required"
          }
        }
      },
      "else": {
        "properties": {
          "pr_ac_ids": {
            "minItems": 1
          },
          "preparation": {
            "type": "null"
          }
        }
      }
    }
  ]
}
