{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "document_type": {
      "const": "knowledge_event"
    },
    "event_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "event_kind": {
      "enum": [
        "candidate",
        "correction",
        "invalidation"
      ]
    },
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}/[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_./-]*$"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16777216
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "repository",
        "commit",
        "path",
        "size",
        "sha256"
      ]
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "\\S"
    },
    "producer_role": {
      "enum": [
        "research-design",
        "implementation",
        "test",
        "review",
        "knowledge"
      ]
    },
    "observation_kind": {
      "enum": [
        "decision",
        "research",
        "failure",
        "test_observation",
        "invalidation"
      ]
    },
    "finding_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "repository": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}/[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
          },
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_./-]*$"
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 16777216
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "repository",
          "commit",
          "path",
          "size",
          "sha256"
        ]
      },
      "minItems": 1,
      "maxItems": 128
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "collected_at": {
      "type": "string",
      "format": "date-time"
    },
    "representation": {
      "enum": [
        "original",
        "edited_derivative"
      ]
    },
    "classification": {
      "enum": [
        "synthetic_sample",
        "public_safe"
      ]
    },
    "issue_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048,
        "pattern": "\\S"
      },
      "minItems": 0,
      "maxItems": 1024
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "minItems": 0,
      "maxItems": 1024
    }
  },
  "required": [
    "schema_version",
    "document_type",
    "event_id",
    "event_kind",
    "source_ref",
    "candidate_id",
    "producer_role",
    "observation_kind",
    "finding_refs",
    "occurred_at",
    "collected_at",
    "representation",
    "classification",
    "issue_refs",
    "supersedes"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-development-system/knowledge-event.schema.json"
}
