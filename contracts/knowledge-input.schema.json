{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "role": {
      "const": "knowledge"
    },
    "task_id": {
      "$ref": "#/$defs/text"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "assignment": {
      "$ref": "#/$defs/assignment"
    },
    "raw_findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/raw_finding"
      },
      "minItems": 1
    },
    "knowledge_references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/knowledge_reference"
      },
      "minItems": 0
    },
    "publication": {
      "enum": [
        "synthetic_sample",
        "public_safe",
        "private_only"
      ]
    },
    "retry_of": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/retry"
      },
      "minItems": 0
    },
    "document_type": {
      "const": "knowledge_input"
    },
    "permissions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "role",
    "task_id",
    "attempt",
    "assignment",
    "raw_findings",
    "knowledge_references",
    "publication",
    "retry_of",
    "document_type",
    "permissions"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Knowledge task input v1.0",
  "allOf": [
    {
      "if": {
        "properties": {
          "attempt": {
            "const": 1
          }
        },
        "required": [
          "attempt"
        ]
      },
      "then": {
        "properties": {
          "retry_of": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "attempt": {
            "minimum": 2
          }
        }
      },
      "then": {
        "properties": {
          "retry_of": {
            "minItems": 1,
            "maxItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "locator": {
          "$ref": "#/$defs/text"
        },
        "revision": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "locator",
        "revision"
      ]
    },
    "raw_finding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/text"
        },
        "domain": {
          "$ref": "#/$defs/text"
        },
        "observation": {
          "$ref": "#/$defs/text"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          },
          "minItems": 1
        },
        "issue_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/text"
              },
              "source": {
                "$ref": "#/$defs/text"
              }
            },
            "required": [
              "id",
              "source"
            ]
          },
          "minItems": 0
        }
      },
      "required": [
        "id",
        "domain",
        "observation",
        "sources",
        "issue_refs"
      ]
    },
    "knowledge_reference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/text"
        },
        "locator": {
          "$ref": "#/$defs/text"
        },
        "revision": {
          "$ref": "#/$defs/text"
        },
        "applicability": {
          "$ref": "#/$defs/text"
        },
        "exceptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "minItems": 0
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          },
          "minItems": 1
        },
        "lifecycle": {
          "enum": [
            "draft",
            "active",
            "deprecated",
            "superseded"
          ]
        },
        "review_trigger": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "id",
        "locator",
        "revision",
        "applicability",
        "exceptions",
        "sources",
        "lifecycle",
        "review_trigger"
      ]
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope": {
          "$ref": "#/$defs/text"
        },
        "completion_criteria": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "minItems": 1
        }
      },
      "required": [
        "scope",
        "completion_criteria"
      ]
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "$ref": "#/$defs/text"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "handoff_locator": {
          "$ref": "#/$defs/text"
        },
        "revision": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "task_id",
        "attempt",
        "handoff_locator",
        "revision"
      ]
    }
  }
}
