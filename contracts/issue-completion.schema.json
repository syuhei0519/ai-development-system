{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-development-system/issue-completion.schema.json",
  "title": "issue-completion v1.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "document_type": {
      "const": "issue_completion_assessment"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "assessor_role": {
      "const": "manager"
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time"
    },
    "context_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "issue_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/criterion"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "scope_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "member_results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/member_result"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "deployment_results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/deployment_result"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "verification_results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/verification_result"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "ac_results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ac_result"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "integration_readiness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "ready",
            "blocked"
          ]
        },
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "scope": {
              "$ref": "#/$defs/proof"
            },
            "required_merges": {
              "$ref": "#/$defs/proof"
            },
            "deployment": {
              "$ref": "#/$defs/proof"
            },
            "compatibility": {
              "$ref": "#/$defs/proof"
            },
            "measurement_coverage": {
              "$ref": "#/$defs/proof"
            },
            "current_evidence": {
              "$ref": "#/$defs/proof"
            },
            "authorizations": {
              "$ref": "#/$defs/proof"
            }
          },
          "required": [
            "scope",
            "required_merges",
            "deployment",
            "compatibility",
            "measurement_coverage",
            "current_evidence",
            "authorizations"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "status",
        "checks",
        "evidence_ids",
        "reason"
      ]
    },
    "issue_completion": {
      "enum": [
        "achieved",
        "not_achieved",
        "unverified"
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "previous_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/blob"
            },
            {
              "type": "null"
            }
          ]
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "previous_ref",
        "events"
      ]
    }
  },
  "required": [
    "schema_version",
    "document_type",
    "artifact_id",
    "assessor_role",
    "evaluated_at",
    "context_sha256",
    "issue_id",
    "acceptance_criteria",
    "scope_revision",
    "member_results",
    "deployment_results",
    "evidence",
    "verification_results",
    "ac_results",
    "integration_readiness",
    "issue_completion",
    "reasons",
    "history"
  ],
  "$defs": {
    "ac_result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ac_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "outcome": {
          "enum": [
            "met",
            "not_met",
            "unverified"
          ]
        },
        "verification_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "ac_id",
        "outcome",
        "verification_ids",
        "evidence_ids"
      ]
    },
    "binding": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "pr"
            },
            "member_id": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "subject": {
              "$ref": "#/$defs/subject"
            },
            "scope_revision": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "type",
            "member_id",
            "subject",
            "scope_revision"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "integration"
            },
            "context_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "scope_revision": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "merged_members": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/merged_member"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "deployments": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/deployment_vector"
              },
              "minItems": 0,
              "uniqueItems": true
            }
          },
          "required": [
            "type",
            "context_sha256",
            "scope_revision",
            "merged_members",
            "deployments"
          ]
        }
      ]
    },
    "blob": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        }
      },
      "required": [
        "id",
        "locator",
        "sha256",
        "size"
      ]
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "verbatim": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "verification_phase": {
          "enum": [
            "premerge",
            "postmerge",
            "postdeploy"
          ]
        }
      },
      "required": [
        "id",
        "verbatim",
        "source",
        "verification_phase"
      ]
    },
    "deployment_result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "deployment_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "status": {
          "enum": [
            "ready",
            "blocked",
            "failed",
            "rolled_back"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "deployment_id",
        "status",
        "evidence_ids",
        "reason"
      ]
    },
    "deployment_vector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "deployment_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "config_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "images": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/image"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "environment_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "workload_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "deployment_id",
        "sources",
        "config_sha256",
        "images",
        "environment_id",
        "workload_id"
      ]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "kind": {
          "enum": [
            "head_changed",
            "required_set_changed",
            "config_changed",
            "deployment_changed",
            "expired",
            "measurement_failed",
            "rollback",
            "revert",
            "revalidated",
            "superseded"
          ]
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "affected_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/blob"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "event_id",
        "kind",
        "observed_at",
        "affected_ids",
        "reason",
        "evidence_refs"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "kind": {
          "enum": [
            "scope",
            "authorization",
            "merge_binding",
            "deployment",
            "compatibility",
            "ac_measurement",
            "integration",
            "rollback",
            "failure"
          ]
        },
        "phase": {
          "enum": [
            "premerge",
            "postmerge",
            "postdeploy"
          ]
        },
        "member_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "deployment_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "verification_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "ac_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "environment_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "workload_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "expected_result": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "merge": {
          "anyOf": [
            {
              "$ref": "#/$defs/merge"
            },
            {
              "type": "null"
            }
          ]
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "valid_until": {
          "type": "string",
          "format": "date-time"
        },
        "producer": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "independent": {
          "type": "boolean"
        },
        "result": {
          "enum": [
            "pass",
            "fail",
            "pending"
          ]
        },
        "source_ref": {
          "$ref": "#/$defs/blob"
        },
        "observation": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "id",
        "kind",
        "phase",
        "member_ids",
        "deployment_ids",
        "verification_ids",
        "ac_ids",
        "binding",
        "environment_id",
        "workload_id",
        "method",
        "expected_result",
        "merge",
        "observed_at",
        "valid_until",
        "producer",
        "independent",
        "result",
        "source_ref",
        "observation"
      ]
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "component": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "component",
        "digest"
      ]
    },
    "member_result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "member_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "readiness_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/blob"
            },
            {
              "type": "null"
            }
          ]
        },
        "readiness_context_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/blob"
            },
            {
              "type": "null"
            }
          ]
        },
        "readiness_handoff_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/blob"
            },
            {
              "type": "null"
            }
          ]
        },
        "gate_checked_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "approved_head_sha": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "actual_merge_sha": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "merged_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "merge_binding": {
          "$ref": "#/$defs/proof"
        },
        "historical_merge_gate": {
          "$ref": "#/$defs/proof"
        }
      },
      "required": [
        "member_id",
        "readiness_ref",
        "readiness_context_ref",
        "readiness_handoff_ref",
        "gate_checked_at",
        "approved_head_sha",
        "actual_merge_sha",
        "merged_at",
        "merge_binding",
        "historical_merge_gate"
      ]
    },
    "merge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "member_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "head_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "base_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "target_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "merge_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "merged_at": {
          "type": "string",
          "format": "date-time"
        },
        "method": {
          "enum": [
            "merge",
            "squash",
            "rebase",
            "queue"
          ]
        }
      },
      "required": [
        "member_id",
        "head_sha",
        "base_sha",
        "target_revision",
        "merge_sha",
        "merged_at",
        "method"
      ]
    },
    "merged_member": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "member_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "merge_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "required": [
        "member_id",
        "merge_sha"
      ]
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "verdict": {
          "enum": [
            "pass",
            "fail",
            "pending"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "verdict",
        "evidence_ids",
        "reason"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "verdict": {
                "enum": [
                  "pass",
                  "fail"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "minItems": 1,
                "uniqueItems": true
              }
            }
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "required": [
        "repository",
        "revision"
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "$ref": "#/$defs/text"
        },
        "pr_number": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "head_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "base_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "target_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "config_revision": {
          "$ref": "#/$defs/text"
        },
        "merge_group_sha": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "repository",
        "pr_number",
        "head_sha",
        "base_sha",
        "target_revision",
        "config_revision",
        "merge_group_sha"
      ]
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "verification_result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "verification_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "outcome": {
          "enum": [
            "met",
            "not_met",
            "unverified"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "verification_id",
        "outcome",
        "evidence_ids",
        "reason"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "enum": [
