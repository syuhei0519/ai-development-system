{
  "description": "Platform Lab の最小ガードレール。main への push、別クラスタの操作、資格情報の読み取りを実行前に止める",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/guard-git.sh\""
          }
        ]
      }
    ]
  }
}
