{
  "permissions": {
    "allow": [
      "Bash(make help)", "Bash(make doctor)", "Bash(make lint)", "Bash(make test)",
      "Bash(make status)", "Bash(make smoke)", "Bash(make urls)", "Bash(make up)",
      "Bash(kubectl get:*)", "Bash(kubectl describe:*)", "Bash(kubectl logs:*)",
      "Bash(kubectl top:*)", "Bash(kubectl events:*)",
      "Bash(argocd app get:*)", "Bash(argocd app list:*)", "Bash(argocd app diff:*)",
      "Bash(helm lint:*)", "Bash(helm template:*)",
      "Bash(git status)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git switch:*)",
      "Bash(git add:*)", "Bash(git commit:*)",
      "Bash(gh pr view:*)", "Bash(gh pr list:*)", "Bash(gh pr checks:*)",
      "Bash(gh pr create:*)", "Bash(gh run view:*)", "Bash(gh run list:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(make down)", "Bash(make reset)", "Bash(make clean:*)",
      "Bash(kubectl delete:*)", "Bash(kubectl apply:*)", "Bash(kubectl patch:*)",
      "Bash(kubectl scale:*)", "Bash(kubectl edit:*)", "Bash(kubectl rollout:*)",
      "Bash(argocd app sync:*)", "Bash(argocd app delete:*)",
      "Bash(helm upgrade:*)", "Bash(helm uninstall:*)",
      "Bash(kind:*)", "Bash(docker system prune:*)", "Bash(docker volume:*)"
    ],
    "deny": [
      "Bash(git push origin main:*)", "Bash(git push --force:*)", "Bash(git push -f:*)",
      "Bash(gh pr merge:*)",
      "Read(~/.lab/**)", "Read(~/.ssh/**)", "Read(~/.kube/**)",
      "Read(~/.config/op/**)", "Read(~/.config/gh/**)",
      "Read(./**/.env)", "Read(./**/*.pem)", "Read(./**/*.key)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": false,
    "excludedCommands": ["docker *", "kind *"],
    "filesystem": {
      "denyRead": [
        "~/.lab", "~/.ssh", "~/.kube", "~/.docker/config.json",
        "~/.config/op", "~/.config/gh", "~/**/.env"
      ],
      "allowRead": ["~/.kube/platform-lab.yaml"],
      "allowWrite": ["~/.kube/cache"]
    },
    "network": {
      "allowedDomains": [
        "github.com", "api.github.com", "*.githubusercontent.com", "*.github.io",
        "*.atlassian.net", "ghcr.io", "registry.k8s.io", "quay.io",
        "docker.io", "*.docker.io"
      ]
    }
  },
  "extraKnownMarketplaces": {
    "ai-development-system": {
      "source": {"source": "github", "repo": "syuhei0519/ai-development-system"}
    }
  },
  "enabledPlugins": {"platform-lab@ai-development-system": true}
}
